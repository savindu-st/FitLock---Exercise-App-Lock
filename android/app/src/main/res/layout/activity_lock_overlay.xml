<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#0F172A"
    android:padding="32dp">

    <!-- Spacer to push content up slightly -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Lock Icon Container -->
    <FrameLayout
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:background="@drawable/bg_lock_icon"
        android:layout_marginBottom="32dp">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:src="@android:drawable/ic_lock_lock"
            android:contentDescription="Locked"
            android:tint="#60A5FA" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/lockTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="App is Locked"
        android:textColor="#F8FAFC"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/lockSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Complete an exercise challenge to unlock"
        android:textColor="#94A3B8"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- Reps Info -->
    <TextView
        android:id="@+id/lockRepsInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="5 reps required"
        android:textColor="#93C5FD"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="@drawable/bg_rounded_badge"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_marginBottom="0dp" />

    <!-- Flexible space to push buttons to bottom -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.5" />

    <!-- Complete Exercise Button -->
    <Button
        android:id="@+id/btnCompleteExercise"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Complete Exercise"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:background="@drawable/bg_primary_button"
        android:layout_marginBottom="16dp" />

    <!-- Go Back Button -->
    <Button
        android:id="@+id/btnGoBack"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Go Back"
        android:textColor="#94A3B8"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:background="@drawable/bg_secondary_button"
        android:layout_marginBottom="32dp" />

</LinearLayout>
